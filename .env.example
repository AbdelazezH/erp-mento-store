# ─── Neon.tech Database ───────────────────────────────────────────────────────
# Pooler URL (hostname contains "-pooler") — used at runtime by the app
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct URL (same but REMOVE "-pooler" from hostname) — used only by drizzle-kit migrations
DIRECT_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-32-plus-character-random-secret

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Base URL used in invitation emails. Set to your domain in production.
NEXTAUTH_URL=http://localhost:3000

# ─── Email (SMTP) — for user invitations ──────────────────────────────────────
# Gmail: use an App Password (myaccount.google.com → Security → App passwords)
# Requires 2-Step Verification to be enabled first.
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
